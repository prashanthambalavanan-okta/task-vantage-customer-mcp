# --- MCP server (required for real Okta auth) ---
OKTA_DOMAIN=https://your-org.okta.com
OKTA_CUSTOMER_AUTH_SERVER_ID=
OKTA_CUSTOMER_AUDIENCE=api://task-vantage-customer

# --- Common ---
PORT=3000
# Skip token validation and grant every scope — local dev only, never set this
# in a deployed environment.
ALLOW_INSECURE=false
# Set to false to serve the MCP endpoint only, without the tester UI.
ENABLE_TESTER_UI=true

# --- Tester UI (only needed if ENABLE_TESTER_UI is not false) ---
# The human logs in as this same AI Agent identity (Authorization Code + PKCE
# + a private_key_jwt client assertion signed by OKTA_AI_AGENT_PRIVATE_KEY —
# no client secret). The agent then reuses this identity to run the ID-JAG
# exchange on the user's behalf.
OKTA_AI_AGENT_ID=
OKTA_AI_AGENT_PRIVATE_KEY=
# Issuer the human login runs against — the org issuer (https://{domain}) or a
# Custom AS issuer (https://{domain}/oauth2/{ausId}). Optional: defaults to the
# org issuer derived from OKTA_DOMAIN.
OKTA_ISSUER=
# Optional — set only if the login issuer is a specific Custom AS, not the org issuer.
OKTA_MAIN_AUTH_SERVER_ID=
# The agent's resource URL. Sent as the RFC 8707 `resource` parameter on the
# human login so the user's access token is audience-bound to the agent. Optional.
OKTA_AI_AGENT_AUDIENCE=
# Force which login token is used as the ID-JAG subject token: id_token|access_token. Optional.
OKTA_ID_JAG_SUBJECT_TOKEN=

# Override the OAuth callback URL if it can't be derived from the request. Optional.
REDIRECT_URI=
